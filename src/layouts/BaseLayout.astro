---
import faviconUrl from '../favicon.ico?url';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gerlis Álvarez Cardona — Senior Frontend Developer',
  description = 'The portfolio and field notes of frontend developer Gerlis Álvarez Cardona.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const homeUrl = base;
const blogUrl = `${base}blog/`;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle(
          'dark',
          saved === 'dark' || (!saved && prefersDark),
        );
      })();
    </script>
  </head>
  <body class="min-h-screen transition-colors duration-300">
    <header class="relative z-50 border-b border-current/15">
      <nav class="mx-auto flex max-w-360 items-center justify-between px-5 py-4 sm:px-8 lg:px-12" aria-label="Main navigation">
        <a class="font-mono text-sm font-bold tracking-tight hover:text-coral" href={homeUrl}>
          ~/about-me
        </a>
        <div class="flex items-center gap-5 font-mono text-xs uppercase tracking-widest">
          <a
            class:list={['transition-colors hover:text-coral', { 'text-coral': pathname === homeUrl }]}
            href={homeUrl}
          >
            Home
          </a>
          <a
            class:list={['transition-colors hover:text-coral', { 'text-coral': pathname.startsWith(blogUrl) }]}
            href={blogUrl}
          >
            Blog
          </a>
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mx-auto flex max-w-360 flex-col gap-2 border-t border-current/15 px-5 py-8 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
      <span>Built slowly. Shipped deliberately.</span>
      <span>© {new Date().getFullYear()} Gerlis Álvarez Cardona</span>
    </footer>
  </body>
</html>
